# Copy this file to .env (for Docker / docker compose) or .env.local (for `npm run dev`)
# and fill in real values. Do NOT commit the filled-in file.

# Optional. Only used on the very first start, while there are no admin
# accounts: creates an administrator with this password, who must choose a new
# one at first sign-in. Once any account exists it is ignored, and can be
# removed. Leave it unset to get a one-time setup code in the server log instead.
# ADMIN_PASSWORD=
# ADMIN_USERNAME=admin

# Optional: how long an admin stays signed in.
# SESSION_IDLE_HOURS=8     # signed out after this long without activity
# SESSION_MAX_HOURS=12     # signed out this long after signing in, however active

# Optional: port the server listens on. Defaults to 3000.
# PORT=3000
