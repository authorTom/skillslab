# Copy this file to .env (for Docker / docker compose) or .env.local (for `npm run dev`)
# and fill in real values. Do NOT commit the filled-in file.

# Optional. Only used on the very first start, while there are no admin
# accounts: creates an administrator with this password, who must choose a new
# one at first sign-in. Once any account exists it is ignored, and can be
# removed. Leave it unset to get a one-time setup code in the server log instead.
# ADMIN_PASSWORD=
# ADMIN_USERNAME=admin

# Optional: how long an admin stays signed in.
# SESSION_IDLE_HOURS=8     # signed out after this long without activity
# SESSION_MAX_HOURS=12     # signed out this long after signing in, however active

# Optional: port the server listens on. Defaults to 3000.
# PORT=3000

# --- HTTPS (the caddy service in compose.yaml) ---------------------------------

# The name staff browsers and iPads use to reach SkillsLab. It must resolve to
# this server on your network, and match the certificate.
SKILLSLAB_HOSTNAME=skillslab.localhost

# Which certificate Caddy serves:
#   internal   Caddy's own CA issues one. Devices must trust Caddy's root
#              certificate (see the README).
#   "/certs/<cert> /certs/<key>"
#              A certificate and key from your organisation's CA, as PEM files
#              in SKILLSLAB_CERTS_DIR. The cert file should hold the full chain.
# SKILLSLAB_TLS=internal
# SKILLSLAB_TLS=/certs/skillslab.crt /certs/skillslab.key

# Folder holding those files, mounted read-only into Caddy at /certs.
# SKILLSLAB_CERTS_DIR=./certs

# Host ports Caddy listens on.
# HTTPS_PORT=443
# HTTP_PORT=80

# --- Backups ---------------------------------------------------------------------

# Where `docker compose exec app node scripts/backup.mjs` writes snapshots. A
# host folder (owned by uid 1000, the container's user) such as a mounted
# network share, or the name of a Docker volume. Defaults to a named volume.
# SKILLSLAB_BACKUP_PATH=/mnt/backups/skillslab

# How many snapshots to keep (oldest are deleted). Defaults to 14.
# BACKUP_KEEP=14
