-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>release-testing</string>
	<key>teamID</key>
	<string>X97G245HKP</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>thinning</key>
	<string>&lt;none&gt;</string>
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
